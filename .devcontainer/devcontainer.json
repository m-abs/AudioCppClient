{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/refs/heads/main/schemas/devContainer.schema.json",
  "name": "C# (.NET) and MS SQL",
  "dockerComposeFile": [
    "docker-compose.yml",
    "docker-compose.override.yml"
  ],
  "service": "app",
  "workspaceFolder": "/workspaces",
  // Features to add to the dev container. More info: https://containers.dev/features.
  // Configure tool-specific properties.
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      // Set *default* container specific settings.json values on container create.
      "settings": {
        "[csharp]": {
          "editor.formatOnSave": true,
          "editor.tabSize": 4,
          "files.encoding": "utf8"
        },
        "editor.tabSize": 2,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          },
          "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux"
          }
        }
      },
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "editorconfig.editorconfig",
        "ms-dotnettools.csdevkit",
        "streetsidesoftware.code-spell-checker-danish",
        "streetsidesoftware.code-spell-checker-norwegian-bokmal",
        "streetsidesoftware.code-spell-checker-swedish",
        "streetsidesoftware.code-spell-checker",
        "wayou.vscode-todo-highlight",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "yzhang.markdown-all-in-one",
        "ms-vscode-remote.remote-containers",
        "EditorConfig.EditorConfig",
        "foxundermoon.shell-format",
        "cweijan.vscode-myssql-client2"
      ]
    }
  },
  "forwardPorts": [
    5000,
    5001
  ],
  "portsAttributes": {
    "5001": {
      "protocol": "https"
    }
  },
  "postCreateCommand": "./.devcontainer/postCreate.sh",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {},
    "ghcr.io/wxw-matt/devcontainer-features/command_runner:0": {},
    "ghcr.io/stuartleeks/dev-container-features/shell-history:0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    },
    "ghcr.io/joshuanianji/devcontainer-features/github-cli-persistence:1": {},
    "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
      "plugins": "ssh-agent npm git dotnet gh",
      "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions",
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "installTools": false,
      "version": "os-provided"
    },
    "ghcr.io/devcontainer-community/devcontainer-features/opencode.ai:1": {}
  },
  "mounts": [
    // Mount NuGet to share github authentication with the container
    "source=${localEnv:HOME}/.nuget/NuGet/,target=/home/vscode/.nuget/NuGet/,type=bind",

    // Mount GitHub CLI configuration to share authentication with the container
    "source=${localEnv:HOME}/.config/gh/,target=/home/vscode/.config/gh/,type=bind",

    // Mount SSH keys to share authentication with the container
    "type=bind,source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,readonly"
  ]
}
