<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Mabs.AudioCpp</RootNamespace>
    <AssemblyName>AudioCpp</AssemblyName>
    <Version>0.1.0</Version>
    <IsPackable>true</IsPackable>
    <PackageId>Mabs.AudioCppClient</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>.NET client for the audio.cpp server protocol (https://github.com/0xShug0/audio.cpp): speech, transcription, alignment, live routes, generic tasks, batches, recipes, voices and model management.</Description>
    <Authors>Morten Sjøgren</Authors>
    <PackageTags>audio;cpp;tts;asr;speech;transcription;audio.cpp</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AudioCpp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.3.177-beta">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>